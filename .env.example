APP_ENV=development
# Generate for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///library.sqlite
PUBLIC_BASE_URL=http://127.0.0.1:5000
TRUSTED_HOSTS=127.0.0.1,localhost
# In production use redis://127.0.0.1:6379/0; memory is for local single-process runs.
RATELIMIT_STORAGE_URI=memory://
READ_RATE_LIMIT=30 per minute;300 per hour
TRUST_PROXY=0
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUBSCRIBERS_CHAT_ID=
# Keep disabled until the Boosty group and bot are configured and verified.
SUBSCRIPTIONS_ENABLED=0
MEMBERSHIP_CACHE_SECONDS=300
BOOSTY_URL=
FINGERPRINT_ENABLED=1
AUDIT_RETENTION_DAYS=7
